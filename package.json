{
  "name": "dsh-llm-session-header",
  "version": "0.3.1",
  "description": "DeepSeek Harness plugin: attaches a stable per-conversation session header to model requests routed to configured providers. Header name is configurable, so one plugin serves SMG (X-SMG-Routing-Key), OpenCode (x-opencode-session), and any other header-based affinity router.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snailium/dsh-llm-session-header.git"
  },
  "homepage": "https://github.com/snailium/dsh-llm-session-header#readme",
  "bugs": {
    "url": "https://github.com/snailium/dsh-llm-session-header/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build:client": "node scripts/build-client.js",
    "test": "node --test tests/test.mjs tests/config-update.test.mjs tests/client-controller.test.mjs && node tests/integration.mjs && node tests/coexistence.mjs && node tests/slot-contract.mjs && node tests/compat-0.2.mjs",
    "test:0.2": "DSH_020=${DSH_020:-$HOME/.dsh/profiles/web} node tests/compat-0.2.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "session-header",
    "session-affinity",
    "prompt-cache",
    "kv-cache",
    "x-opencode-session",
    "x-smg-routing-key",
    "opencode",
    "smg",
    "shepherd-model-gateway",
    "olla",
    "llm",
    "routing"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2 || >=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
